# ── Public site ───────────────────────────────────────────────
# Canonical URL (used for sitemap.xml, canonical tags, Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional: where people buy a Nuvio Plus key (shop / WhatsApp / Discord link).
NEXT_PUBLIC_PURCHASE_URL=

# ── Database (SQLite) ─────────────────────────────────────────
# Relative paths are resolved from the prisma/ folder. Docker uses /app/data/nuvio.db.
DATABASE_URL="file:./dev.db"

# ── GitHub Releases (server side only, never sent to the browser) ──
# "owner/name" of the repository that publishes the app builds.
GITHUB_REPO=
# Fine-grained token with read access to Contents/Releases. Required for private repos,
# recommended for public ones (higher rate limit).
GITHUB_TOKEN=

# ── Admin console ─────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
# Generate with: npm run admin:hash -- "your password"
ADMIN_PASSWORD_HASH=
# At least 32 random characters. Example: openssl rand -hex 32
SESSION_SECRET=

# ── Nuvio Account ─────────────────────────────────────────────
# Email OTP (required in production, otherwise registration cannot send codes).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nuvio Launcher <no-reply@your-domain.com>"

# Google sign-in (optional). Authorised redirect URI:
#   <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Uploaded skins/capes and the Yggdrasil signing key live under ./data (mount it as a volume).
TEXTURES_DIR=./data/textures
# Optional: PEM private key for Yggdrasil signatures (use \n for newlines). Auto-generated into
# YGGDRASIL_KEY_FILE on first start when empty.
YGGDRASIL_PRIVATE_KEY=
YGGDRASIL_KEY_FILE=./data/yggdrasil-private.pem
